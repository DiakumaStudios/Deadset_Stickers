<a class="post-card pop rv" style="--i:{{ i }}" href="{{ post.url }}">
  <div class="post-art tone-{{ post.data.tone }}"><img src="/assets/img/{{ post.data.art }}.svg" alt="" loading="lazy"></div>
  <div class="post-body">
    <div class="post-meta"><span class="post-tag">{{ post.data.tag }}</span><span>{{ post.date | auDate }}</span></div>
    <h2>{{ post.data.title }}</h2>
    <p>{{ post.data.excerpt }}</p>
    <span class="read-more">Read more <i>→</i></span>
  </div>
</a>
